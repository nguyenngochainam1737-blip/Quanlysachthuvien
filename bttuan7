import java.util.ArrayList;
import java.util.Scanner;

// Yêu cầu 1: Lớp Sach biểu diễn thông tin một cuốn sách
class Sach {
    String maSach;
    String tieuDe;
    String tacGia;
    int namXuatBan;
    int soLuong;

    // Constructor mặc định
    public Sach() {
    }

    // Constructor có tham số để khởi tạo nhanh đối tượng
    public Sach(String maSach, String tieuDe, String tacGia, int namXuatBan, int soLuong) {
        this.maSach = maSach;
        this.tieuDe = tieuDe;
        this.tacGia = tacGia;
        this.namXuatBan = namXuatBan;
        this.soLuong = soLuong;
    }

    // Yêu cầu 2: Phương thức hienThiThongTin() để in chi tiết sách
    public void hienThiThongTin() {
        System.out.println("--------------------------------------------------");
        System.out.println("Mã sách     : " + maSach);
        System.out.println("Tiêu đề     : " + tieuDe);
        System.out.println("Tác giả     : " + tacGia);
        System.out.println("Năm xuất bản: " + namXuatBan);
        System.out.println("Số lượng    : " + soLuong);
        System.out.println("--------------------------------------------------");
    }
}

// Yêu cầu 3 & 4: Lớp Test tạo đối tượng và quản lý danh sách Sach bằng ArrayList
public class Test {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        ArrayList<Sach> danhSachSach = new ArrayList<>();
        int luaChon;

        do {
            System.out.println("\n========== QUẢN LÝ THƯ VIỆN - BÀI THỰC HÀNH TUẦN 7 ==========");
            System.out.println("1. Thêm một cuốn sách mới");
            System.out.println("2. Hiển thị danh sách các cuốn sách");
            System.out.println("3. Tìm kiếm sách theo mã sách");
            System.out.println("4. Thoát chương trình");
            System.out.print("Nhập lựa chọn của bạn (1-4): ");
            luaChon = scanner.nextInt();
            scanner.nextLine(); // Đọc bỏ dòng trống sau khi nhập số

            switch (luaChon) {
                case 1:
                    System.out.println("\n--- NHẬP THÔNG TIN SÁCH MỚI ---");
                    System.out.print("Nhập mã sách: ");
                    String maSach = scanner.nextLine();
                    System.out.print("Nhập tiêu đề sách: ");
                    String tieuDe = scanner.nextLine();
                    System.out.print("Nhập tên tác giả: ");
                    String tacGia = scanner.nextLine();
                    System.out.print("Nhập năm xuất bản: ");
                    int namXuatBan = scanner.nextInt();
                    System.out.print("Nhập số lượng: ");
                    int soLuong = scanner.nextInt();

                    // Tạo đối tượng từ lớp Sach và thêm vào ArrayList
                    Sach sachMoi = new Sach(maSach, tieuDe, tacGia, namXuatBan, soLuong);
                    danhSachSach.add(sachMoi);
                    System.out.println("=> Thêm sách vào danh sách thành công!");
                    break;

                case 2:
                    System.out.println("\n--- DANH SÁCH SÁCH TRONG THƯ VIỆN ---");
                    if (danhSachSach.isEmpty()) {
                        System.out.println("Thư viện hiện chưa có cuốn sách nào.");
                    } else {
                        for (Sach s : danhSachSach) {
                            s.hienThiThongTin();
                        }
                    }
                    break;

                case 3:
                    System.out.print("\nNhập mã sách cần tìm kiếm: ");
                    String maTimKiem = scanner.nextLine();
                    boolean found = false;
                    for (Sach s : danhSachSach) {
                        if (s.maSach.equalsIgnoreCase(maTimKiem)) {
                            System.out.println("=> Đã tìm thấy sách:");
                            s.hienThiThongTin();
                            found = true;
                            break;
                        }
                    }
                    if (!found) {
                        System.out.println("=> Không tìm thấy cuốn sách có mã: " + maTimKiem);
                    }
                    break;

                case 4:
                    System.out.println("Đang thoát chương trình. Tạm biệt!");
                    break;

                default:
                    System.out.println("Lựa chọn không hợp lệ! Vui lòng chọn từ 1 đến 4.");
            }
        } while (luaChon != 4);

        scanner.close();
    }
}